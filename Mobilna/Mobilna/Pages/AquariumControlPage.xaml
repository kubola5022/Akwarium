<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mobilna.AquariumControlPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<ContentPage.Content>
		<ScrollView>
			<VerticalStackLayout Padding="20" Spacing="24">

				<Label Text="Sterowanie urządzeniami"
                       FontSize="24"
                       FontAttributes="Bold" />

				<!-- OŚWIETLENIE -->
				<Frame Padding="12" CornerRadius="16">
					<VerticalStackLayout Spacing="8">
						<Label Text="Oświetlenie"
                               FontSize="18"
                               FontAttributes="Bold" />

						<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
							<Switch x:Name="LightSwitch"
                                    Toggled="OnLightSwitchToggled" />
							<Label x:Name="LightStatusLabel"
                                   Text=""
                                   VerticalOptions="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Frame>

				<!--  Pompa -->
				<Frame Padding="12" CornerRadius="16">
					<VerticalStackLayout Spacing="8">
						<Label Text="Pompa"
                               FontSize="18"
                               FontAttributes="Bold" />

						<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
							<Switch x:Name="PumpSwitch"
                                    Toggled="OnPumpSwitchToggled" />
							<Label x:Name="PumpStatusLabel"
                                   Text=""
                                   VerticalOptions="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Frame>

				<!-- filtr-->
				<Frame Padding="12" CornerRadius="16">
					<VerticalStackLayout Spacing="8">
						<Label Text="Filtr"
                               FontSize="18"
                               FontAttributes="Bold" />

						<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
							<Switch x:Name="FilterSwitch"
                                    Toggled="OnFilterSwitchToggled" />
							<Label x:Name="FilterStatusLabel"
                                   Text=""
                                   VerticalOptions="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Frame>

				<!-- GRZAŁKA -->
				<Frame Padding="12" CornerRadius="16">
					<VerticalStackLayout Spacing="8">
						<Label Text="Grzałka"
                               FontSize="18"
                               FontAttributes="Bold" />

						<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
							<Switch x:Name="HeaterSwitch"
                                    Toggled="OnHeaterSwitchToggled" />
							<Label x:Name="HeaterStatusLabel"
                                   Text=""
                                   VerticalOptions="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Frame>

                <!-- DODATKOWE URZĄDZENIA -->
                <Frame Padding="12" CornerRadius="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Dodatkowe urządzenia"
               FontSize="18"
               FontAttributes="Bold" />

                        <CollectionView x:Name="CustomDevicesCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="OnCustomDeviceSelectionChanged">
                            <CollectionView.EmptyView>
                                <Label Text="Brak dodatkowych urządzeń. Użyj przycisku 'Dodaj urządzenie' poniżej."
                       FontSize="12"
                       FontAttributes="Italic"
                       Opacity="0.7" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="8" Padding="0,4">
                                        <Label Text="{Binding Name}"
                               VerticalOptions="Center"
                               HorizontalOptions="StartAndExpand" />
                                        <Switch IsToggled="{Binding IsOn}"
                                Toggled="OnCustomDeviceToggled" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- PRZYCISKI NA DOLE -->

                <VerticalStackLayout Spacing="8">

                    
                    <HorizontalStackLayout Spacing="12"
                           HorizontalOptions="Center">
                        <Button Text="Dodaj urządzenie"
                Clicked="OnAddDeviceClicked" />
                        <Button Text="Usuń urządzenie"
                Clicked="OnDeleteDeviceClicked" />
                    </HorizontalStackLayout>

                   
                    <Button Text="Ustaw harmonogram"
            Clicked="OnEditScheduleClicked"
            HorizontalOptions="Fill"
            Margin="0,4,0,0" />
                </VerticalStackLayout>


             
                <!-- HARMONOGRAM URZĄDZENIA (DYNAMICZNY) -->
                <Frame x:Name="ScheduleFrame"
       Padding="12"
       CornerRadius="16"
       IsVisible="False">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Harmonogram urządzenia"
               FontSize="18"
               FontAttributes="Bold" />

                        <Label Text="Wybierz urządzenie:" />
                        <Picker x:Name="ScheduleDevicePicker"
                Title="Urządzenie"
                ItemDisplayBinding="{Binding Name}" />

                        <Label Text="Wybierz dni, w których ma działać:" />

                       
                        <Grid ColumnDefinitions="*,*,*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="14"
              Margin="0,6,0,0">

                            <!-- Rząd 1 -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                                <CheckBox x:Name="MonCheck" />
                                <Label Text="Pn" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                                <CheckBox x:Name="TueCheck" />
                                <Label Text="Wt" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                                <CheckBox x:Name="WedCheck" />
                                <Label Text="Śr" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="0" Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                                <CheckBox x:Name="ThuCheck" />
                                <Label Text="Cz" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <!-- Rząd 2 -->
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                                <CheckBox x:Name="FriCheck" />
                                <Label Text="Pt" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                                <CheckBox x:Name="SatCheck" />
                                <Label Text="So" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                                <CheckBox x:Name="SunCheck" />
                                <Label Text="Nd" VerticalTextAlignment="Center"/>
                            </HorizontalStackLayout>

                          
                            <BoxView Grid.Row="1" Grid.Column="3" Opacity="0" />

                        </Grid>

                        <Label Text="Godziny działania (ten sam zakres dla wybranych dni):" />

                        <HorizontalStackLayout Spacing="12">
                            <VerticalStackLayout>
                                <Label Text="Od" />
                                <TimePicker x:Name="StartTimePicker"
                            Time="05:00:00" />
                            </VerticalStackLayout>

                            <VerticalStackLayout>
                                <Label Text="Do" />
                                <TimePicker x:Name="EndTimePicker"
                            Time="12:00:00" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Button Text="Wyślij harmonogram do ESP"
                Clicked="OnSendScheduleClicked" />

                        <Button Text="Usuń harmonogram"
                Margin="0,8,0,0"
                Clicked="OnOpenDeleteSchedulePanelClicked" />

                    </VerticalStackLayout>
                </Frame>

                <!-- KAFELEK: USUWANIE HARMONOGRAMU (osobny) -->
                <Frame x:Name="DeleteScheduleFrame"
       Padding="12"
       CornerRadius="16"
       IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Usuń harmonogram"
               FontSize="18"
               FontAttributes="Bold" />

                        <Label Text="Wybierz harmonogram do usunięcia:" />

                        <Picker x:Name="DeleteSchedulePicker"
                Title="Wybierz urządzenie z harmonogramem"
                ItemDisplayBinding="{Binding DeviceName}" />

                        <Button Text="Usuń wybrany harmonogram"
                BackgroundColor="Red"
                TextColor="White"
                Clicked="OnConfirmDeleteScheduleClicked" />

                        <Button Text="Anuluj"
                Clicked="OnCancelDeleteScheduleClicked" />
                    </VerticalStackLayout>
                </Frame>



                <Frame Padding="12" CornerRadius="16" Margin="0,12,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Aktualne harmonogramy"
               FontSize="18"
               FontAttributes="Bold" />

                        <CollectionView x:Name="SchedulePreviewCollectionView"
                        HeightRequest="160">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="4,2">
                                        <Label Text="{Binding DeviceName}"
                               FontAttributes="Bold" />
                                        <Label Text="{Binding Description}"
                               FontSize="12"
                               TextColor="#CCCCCC" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label x:Name="NoScheduleLabel"
               Text="Brak zapisanych harmonogramów."
               FontSize="12"
               TextColor="#CCCCCC"
               IsVisible="False" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
    
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Mobilna.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#020617" Offset="0" />
            <GradientStop Color="#020617" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <VerticalStackLayout
            x:Name="RootLayout"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="10">

           
            <Label x:Name="FishLabel"
                   Text="🐟"
                   FontSize="80"
                   HorizontalOptions="Center" />

         
            <Label Text="Akwarium"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

          
            <Label Text="Sterowanie i podgląd Twoich zbiorników"
                   FontSize="14"
                   TextColor="#9CA3AF"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>
